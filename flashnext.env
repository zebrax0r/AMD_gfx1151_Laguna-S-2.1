# Qwen3.8-Flash-Next (UD-IQ4_XS + MTP head) — alternative to laguna.env.
# Tested 2026-10-06; results and caveats in docs/ALTERNATIVE_MODELS.md.
#
#   ./serve-laguna.sh stop                                  # free the GPU first
#   ENV_FILE=flashnext.env ./serve-laguna.sh serve
#   ENV_FILE=flashnext.env ./serve-laguna.sh wire-qwen-code # point qwen-code at it
#
# Same port, API key, context limits and qwen-code safety settings as
# laguna.env; only the model, llama.cpp build and speculative decoding
# differ. 262144 is this model's own maximum context. With MTP on, only
# ~8GiB of system RAM is left for everything else — don't run anything
# big alongside it.
LLAMA_CPP_DIR="vendor/llama.cpp-master"   # needs master: qwen4exp MTP landed 2026-10-01 (llama.cpp#29761)
MODEL_DIR="models"
LOG_DIR="logs"
SECRETS_DIR=".secrets"
GPU_TARGET="gfx1151"
MODEL_REPO="unsloth/Qwen3.8-Flash-Next-GGUF"
MODEL_FILE="UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf"
MODEL_FILE_EXTRA_SHARDS="UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00002-of-00003.gguf,UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00003-of-00003.gguf"
MODEL_FILE_EXPECT_BYTES=10946624
MMPROJ_FILE=""
SPEC_TYPE="draft-mtp"
SPEC_DRAFT_MODEL="MTP/mtp-Qwen3.8-Flash-Next-Q8_0.gguf"
SERVED_MODEL_NAME="qwen3.8-flash-next"
HOST="127.0.0.1"   # behind the LiteLLM gateway; see laguna-env.example
PORT="8000"
SERVER_HOST="127.0.0.1"
CTX_SIZE="262144"
CLIENT_CTX_SIZE="196608"
QWEN_TOOL_OUTPUT_THRESHOLD="8000"
QWEN_TOOL_OUTPUT_LINES="300"
QWEN_SESSION_TOKEN_LIMIT="229376"
QWEN_CODE_MAX_OUTPUT_TOKENS="10000"
UBATCH_SIZE="2048"
BATCH_SIZE="2048"
PARALLEL="1"
GPU_LAYERS="999"
FLASH_ATTN="auto"
SPEC_DRAFT_N_MAX="3"   # llama.cpp default; what was measured (32-38 tok/s)
API_KEY=""
QWEN_ENV_TARGET="user"
QWEN_PROJECT_DIR=""
